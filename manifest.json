{
  "manifest_version": 3,
  "name": "BatchSave Pro — Bulk File Downloader",
  "version": "1.0.0",
  "description": "Download page files and photos in batches, save visible Gmail attachments, and use local PDF tools in Chrome.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://gcfyaaqqsqrjwujpymjz.supabase.co/*"
  ],
  "action": {
    "default_title": "BatchSave Pro",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "32": "src/assets/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "minimum_chrome_version": "110",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "src/settings/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "src/assets/icon-16.png",
    "32": "src/assets/icon-32.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  },
  "homepage_url": "https://batchsavepro.com/"
}
