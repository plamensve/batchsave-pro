{
  "manifest_version": 3,
  "name": "BatchSave Pro — Bulk File Downloader",
  "version": "0.1.0",
  "description": "Discover and batch download images, PDFs and files from web pages.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "action": {
    "default_title": "BatchSave Pro",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "icons": {},
  "minimum_chrome_version": "110"
}
