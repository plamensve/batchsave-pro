{
  "manifest_version": 3,
  "name": "BatchSave Pro — Bulk File Downloader",
  "version": "0.12.0",
  "description": "Download real page files, photos and Gmail email attachments in batches.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "permissions",
    "identity"
  ],
  "host_permissions": [
    "https://gcfyaaqqsqrjwujpymjz.supabase.co/*",
    "https://gmail.googleapis.com/*"
  ],
  "action": {
    "default_title": "BatchSave Pro",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "minimum_chrome_version": "110",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "oauth2": {
    "client_id": "000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "options_ui": {
    "page": "src/settings/index.html",
    "open_in_tab": true
  }
}
